# Template only — never put a real key in this file, it gets committed to git.
# Your real key belongs in .env (same folder), which is gitignored.

# https://developer.riotgames.com — the development key expires every 24 hours.
# Apply for a personal key once there's a working demo to show.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Not needed yet. The search page reads live from Riot; the database only matters
# once the friend-group leaderboard needs match history over time.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: posts milestones and disasters to your group chat. A group owner
# normally gets this via the "Add to Discord" button (see DISCORD_BOT_TOKEN
# below), which stores it in the database — this env var is only a fallback
# for a group with no owner (e.g. seeded from config/group.json).
# DISCORD_WEBHOOK_URL=

# discord.com/developers/applications > (this app) > Bot > Reset Token.
# Same Application as AUTH_DISCORD_ID/SECRET above — its Bot user, used only
# by the "Add to Discord" install flow (listing a server's channels, minting
# a webhook for the one picked). Needs the OAuth2 redirect
# /api/discord/install/callback registered on that same app.
# DISCORD_BOT_TOKEN=
# View Channels + Manage Webhooks + Send Messages + Embed Links, from the
# permissions calculator at the bottom of the Bot page.
# DISCORD_BOT_PERMISSIONS=536890368
